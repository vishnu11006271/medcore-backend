// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`



generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_TECHNICIAN
  PHARMACIST
  ACCOUNTANT
  PATIENT
}

enum HospitalStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum RecordStatus {
  DRAFT
  FINALIZED
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_VERIFICATION
}

model Hospital {
  id                 String         @id @default(uuid())
  name               String
  slug               String         @unique
  registrationNumber String?        @unique
  email              String
  phone              String?
  address            String?
  status             HospitalStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  users              User[]
  departments        Department[]
  rooms              Room[]
  patients           Patient[]
  appointments       Appointment[]
  medicalRecords     MedicalRecord[]
  medicines          Medicine[]
  labTests           LabTest[]
  invoices           Invoice[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([status, createdAt])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            UserRole
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  hospitalId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctorProfile   Doctor?
  patientProfile  Patient?
  refreshTokens   RefreshToken[]
  emailOtps       EmailOtp[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([hospitalId, role])
  @@index([hospitalId, isActive])
}

model Department {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  code        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctors      Doctor[]
  appointments Appointment[]

  @@unique([hospitalId, name])
  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
}

model Doctor {
  id                String   @id @default(uuid())
  userId            String   @unique
  departmentId      String?
  licenseNumber     String   @unique
  specialization    String
  qualification     String?
  experienceYears   Int?
  consultationFee   Decimal  @default(0) @db.Decimal(12, 2)
  bio               String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]     @relation("LabOrdersByDoctor")

  availabilities DoctorAvailability[]

  @@index([departmentId])
}

model Patient {
  id                String   @id @default(uuid())
  userId            String   @unique
  hospitalId        String
  patientNumber     String
  dateOfBirth       DateTime?
  gender            Gender?
  bloodGroup        String?
  address           String?
  emergencyContact  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  invoices       Invoice[]

  @@unique([hospitalId, patientNumber])
  @@index([hospitalId, createdAt])
}

model Room {
  id         String     @id @default(uuid())
  hospitalId String
  name       String
  type       String
  floor      String?
  capacity   Int        @default(1)
  status     RoomStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, name])
  @@index([hospitalId, status])
}

model Appointment {
  id             String            @id @default(uuid())
  hospitalId     String
  patientId      String
  doctorId       String
  departmentId   String
  scheduledAt    DateTime
  durationMinutes Int              @default(30)
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord?
  invoice      Invoice?

  @@index([hospitalId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([departmentId, status])
}

model MedicalRecord {
  id            String       @id @default(uuid())
  hospitalId    String
  appointmentId String       @unique
  patientId     String
  doctorId      String
  diagnosis     String?
  symptoms      String?
  clinicalNotes String?
  status        RecordStatus @default(DRAFT)
  recordedAt    DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  hospital     Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  appointment  Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  prescriptions Prescription[]
  labOrders     LabOrder[]

  @@index([hospitalId, patientId, recordedAt])
  @@index([doctorId, recordedAt])
}

model Prescription {
  id             String             @id @default(uuid())
  medicalRecordId String
  prescribedById String
  status         PrescriptionStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  medicalRecord MedicalRecord     @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  prescribedBy  Doctor            @relation(fields: [prescribedById], references: [id], onDelete: Restrict)
  items         PrescriptionItem[]

  @@index([medicalRecordId])
}

model Medicine {
  id           String   @id @default(uuid())
  hospitalId   String
  name         String
  genericName  String?
  strength     String?
  manufacturer String?
  stockQuantity Int     @default(0)
  unitPrice    Decimal  @default(0) @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hospital Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  prescriptionItems PrescriptionItem[]

  @@unique([hospitalId, name, strength])
  @@index([hospitalId, isActive])
}

model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String
  medicineId     String
  dosage         String
  frequency      String
  durationDays   Int?
  quantity       Int
  instructions   String?
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@index([medicineId])
}

model LabTest {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  code        String
  description String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  labOrders LabOrder[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
}

model LabOrder {
  id             String        @id @default(uuid())
  medicalRecordId String
  labTestId      String
  orderedById    String?
  status         LabOrderStatus @default(ORDERED)
  resultText     String?
  resultFileUrl  String?
  orderedAt      DateTime      @default(now())
  completedAt    DateTime?
  updatedAt      DateTime      @updatedAt

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  labTest       LabTest       @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  orderedBy     Doctor?       @relation("LabOrdersByDoctor", fields: [orderedById], references: [id], onDelete: SetNull)

  @@index([medicalRecordId, status])
  @@index([labTestId])
}

model Invoice {
  id            String        @id @default(uuid())
  hospitalId    String
  appointmentId String        @unique
  patientId     String
  invoiceNumber String
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  hospital    Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  appointment Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items       InvoiceItem[]

  @@unique([hospitalId, invoiceNumber])
  @@index([hospitalId, status, createdAt])
  @@index([patientId, createdAt])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  itemType    String
  referenceId String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model Notification {
  id             String    @id @default(uuid())
  userId         String
  hospitalId     String?
  title          String
  message        String
  linkedEntityType String?
  linkedEntityId String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([linkedEntityType, linkedEntityId])
}

model AuditLog {
  id         String   @id @default(uuid())
  hospitalId String?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hospitalId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailOtp {
  id         String     @id @default(uuid())
  userId     String?
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, expiresAt])
  @@index([userId, createdAt])
}

model DoctorAvailability {
  id                   String   @id @default(uuid())
  doctorId             String
  dayOfWeek            Int
  startMinute          Int
  endMinute            Int
  slotDurationMinutes  Int      @default(30)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, isActive])
}


