# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://medcore:local_dev_password@localhost:5432/medcore_hms?schema=public

# Generate a long random value; never reuse a production secret in development.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
REFRESH_TOKEN_EXPIRES_DAYS=7

# Frontend and browser CORS
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# SMTP - required for email verification delivery
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=Medcore HMS <no-reply@example.com>

# Razorpay - required only when online payments are enabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set false to hide Swagger UI and the OpenAPI JSON route
SWAGGER_ENABLED=true
